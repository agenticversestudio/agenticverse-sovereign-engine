# AgenticVerse local secrets. NEVER commit or share this file.
AGENTIC_API_KEY=
AGENTIC_PASSKEY=
AGENTIC_LOGIN_USER=
# Old short key kept only so existing apps keep working. Remove after you update the apps.
EXTRA_API_KEYS=
NGROK_TOKEN=
NGROK_DOMAIN=your-name.ngrok-free.dev
# Put a NEW Groq key here for the (clearly labelled) Groq fallback for Qwen. Leave empty to disable.
GROQ_API_KEY=
# 1 account only (Colab FAQ disallows multi-account workarounds). Set 2 or 3 at your own risk.
ACCOUNT_COUNT=1
